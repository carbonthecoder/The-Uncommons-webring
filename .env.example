# The Uncommons — Automated Admissions Webhook & Multi-Cloud Database Configuration

# 1. Discord Webhook for Candidate Submissions
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# 2. Admissions Bot Gateway (Discord API)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_KEY_LEDGER_CHANNEL_ID=1551036698757038181
DISCORD_FOUNDER_VAULT_CHANNEL_ID=1551054421595529286

# 3. High-Speed Multi-Cloud Database (Choose either or both!)
# Option A: MongoDB Atlas (Recommended for production enterprise persistence)
# Create a free cluster at https://cloud.mongodb.com -> Connect -> Drivers -> copy connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=the_uncommons

# Option B: GitHub Gist DB (Fast JSON document store)
# Generate a token with 'gist' permission at https://github.com/settings/tokens:
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GIST_ID=your_existing_gist_id_or_leave_blank_to_autocreate
