# The Uncommons — Automated Admissions Webhook Configuration
# Create a webhook in Discord: #council-review -> Edit Channel -> Integrations -> Webhooks -> Copy Webhook URL
# Paste the URL below and rename this file to .env.local to enable direct auto-delivery into #council-review:

VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
